rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGM() {
      return request.auth != null
          && request.auth.token.email == 'ethoril@gmail.com'
          && request.auth.token.email_verified == true;
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validText(data, field, maximum) {
      return !data.keys().hasAny([field])
          || (data[field] is string && data[field].size() <= maximum);
    }

    function validImagePath(data, ownerId, prefix) {
      return !data.keys().hasAny(['imagePath'])
          || (data.imagePath is string
              && data.imagePath.split('/').size() == 3
              && data.imagePath.split('/')[0] == prefix
              && data.imagePath.split('/')[1] == ownerId
              && data.imagePath.split('/')[2].size() > 0
              && data.imagePath.split('/')[2].size() <= 128);
    }

    function validOwnerId(ownerId) {
      return ownerId is string && ownerId.size() > 0 && ownerId.size() <= 100
          && ownerId.matches('^[A-Za-z0-9_-]+$');
    }

    function validOwnedImagePath(path, ownerId, prefix) {
      return validOwnerId(ownerId) && path is string
          && path.split('/').size() == 3
          && path.split('/')[0] == prefix
          && path.split('/')[1] == ownerId
          && path.split('/')[2].size() > 0
          && path.split('/')[2].size() <= 128
          && path.split('/')[2] != '.' && path.split('/')[2] != '..';
    }

    function validTimestamp(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp;
    }

    function hasWriteTimestamps(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt'])
          && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function hasUpdatedTimestamp(data) {
      return data.keys().hasAny(['updatedAt']) && data.updatedAt is timestamp;
    }

    function validPnj(data) {
      return hasOnly(data, ['nom', 'statut', 'vivant', 'lieu', 'groupe', 'description',
          'imageUrl', 'imagePath', 'visibleJoueurs', 'createdAt', 'updatedAt', 'ordre',
          'suppressionEnCours'])
        && data.visibleJoueurs is bool
        && data.nom is string && data.nom.size() > 0 && data.nom.size() <= 200
        && validText(data, 'statut', 64)
        && validText(data, 'vivant', 32)
        && validText(data, 'lieu', 200)
        && validText(data, 'groupe', 200)
        && validText(data, 'description', 20000)
        && validText(data, 'imageUrl', 2048)
        && validText(data, 'imagePath', 512)
        && (!data.keys().hasAny(['ordre']) || data.ordre == null
            || data.ordre is int || data.ordre is float)
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validDeletionMarker(data) {
      return !data.keys().hasAny(['suppressionEnCours'])
          || data.suppressionEnCours is bool;
    }

    function validRelation(data) {
      return hasOnly(data, ['source', 'cible', 'type', 'label', 'color', 'style',
          'visibleJoueurs', 'createdAt', 'updatedAt'])
        && data.visibleJoueurs is bool
        && data.source is string && data.source.size() > 0 && data.source.size() <= 150
        && data.cible is string && data.cible.size() > 0 && data.cible.size() <= 150
        && data.source != data.cible
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && validText(data, 'label', 300)
        && (!data.keys().hasAny(['color']) || data.color == null || validText(data, 'color', 32))
        && (!data.keys().hasAny(['style']) || data.style == 'solid' || data.style == 'dashed')
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validPrivatePnj(data) {
      return hasOnly(data, ['notes', 'updatedAt'])
        && data.notes is string && data.notes.size() <= 30000
        && validTimestamp(data, 'updatedAt');
    }

    function validIndice(data) {
      return hasOnly(data, ['titre', 'description', 'decouvert', 'pnjsLies', 'imageUrl',
          'imagePath', 'dateDecouverte', 'source', 'type', 'createdAt', 'updatedAt', 'ordre'])
        && data.titre is string && data.titre.size() > 0 && data.titre.size() <= 200
        && data.decouvert is bool
        && data.pnjsLies is list
        && data.pnjsLies.size() <= 100
        && validText(data, 'description', 30000)
        && validText(data, 'imageUrl', 2048)
        && validText(data, 'imagePath', 512)
        && (!data.keys().hasAny(['dateDecouverte']) || data.dateDecouverte == null
            || data.dateDecouverte is timestamp)
        && validText(data, 'source', 150)
        && validText(data, 'type', 100)
        && (!data.keys().hasAny(['ordre']) || data.ordre == null
            || data.ordre is int || data.ordre is float)
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validUpdate(oldData, newData, validator) {
      return newData.diff(oldData).affectedKeys().hasOnly(validator);
    }

    function createdAtUnchanged(oldData, newData) {
      return !oldData.keys().hasAny(['createdAt'])
          || newData.createdAt == oldData.createdAt;
    }

    function legacyImageUrlUnchanged(oldData, newData) {
      return !newData.keys().hasAny(['imageUrl'])
          || (oldData.keys().hasAny(['imageUrl']) && newData.imageUrl == oldData.imageUrl);
    }

    function serverCreatedAndUpdated(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function serverUpdated(data) {
      return data.updatedAt == request.time;
    }

    function relationEndpointsExist(data) {
      let sourceRef = /databases/$(database)/documents/pnjs/$(data.source);
      let cibleRef = /databases/$(database)/documents/pnjs/$(data.cible);
      return existsAfter(sourceRef) && existsAfter(cibleRef)
          && getAfter(sourceRef).data.get('suppressionEnCours', false) != true
          && getAfter(cibleRef).data.get('suppressionEnCours', false) != true;
    }

    function activePnjAfter(id) {
      let pnjRef = /databases/$(database)/documents/pnjs/$(id);
      return existsAfter(pnjRef)
          && getAfter(pnjRef).data.get('suppressionEnCours', false) != true;
    }

    function deletionLockRef() {
      return /databases/$(database)/documents/integrity_locks/pnj-deletion;
    }

    function deletionLockActive() {
      return exists(deletionLockRef());
    }

    function validDeletionLock(data) {
      return hasOnly(data, ['pnjId', 'imagePaths', 'createdAt', 'updatedAt'])
          && data.pnjId is string && data.pnjId.size() > 0 && data.pnjId.size() <= 150
          && data.imagePaths is list && data.imagePaths.size() <= 2
          && (data.imagePaths.size() == 0
              || validOwnedImagePath(data.imagePaths[0], data.pnjId, 'portraits'))
          && (data.imagePaths.size() < 2
              || validOwnedImagePath(data.imagePaths[1], data.pnjId, 'portraits'))
          && hasWriteTimestamps(data);
    }

    function lockAfterTargetsPnj(id) {
      return existsAfter(deletionLockRef())
          && getAfter(deletionLockRef()).data.get('pnjId', '') == id;
    }

    function cascadeIndiceUpdate(oldData, newData) {
      return deletionLockActive()
          && newData.diff(oldData).affectedKeys().hasOnly(['pnjsLies', 'updatedAt'])
          && oldData.pnjsLies is list && newData.pnjsLies is list
          && oldData.pnjsLies.hasAny([get(deletionLockRef()).data.pnjId])
          && !newData.pnjsLies.hasAny([get(deletionLockRef()).data.pnjId])
          && oldData.pnjsLies.hasAll(newData.pnjsLies)
          && newData.pnjsLies.size() == oldData.pnjsLies.size() - 1;
    }

    function imageLockRef(ownerCollection, ownerId) {
      return /databases/$(database)/documents/integrity_locks/images/$(ownerCollection)/$(ownerId);
    }

    function imageLockActive(ownerCollection, ownerId) {
      return exists(imageLockRef(ownerCollection, ownerId));
    }

    function changesImage(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasAny(['imagePath', 'imageUrl']);
    }

    function validImageCleanupLock(data, ownerCollection, ownerId) {
      let prefix = ownerCollection == 'pnjs' ? 'portraits' : 'indices';
      return hasOnly(data, ['ownerCollection', 'ownerId', 'path', 'createdAt', 'updatedAt'])
          && data.ownerCollection == ownerCollection
          && data.ownerId == ownerId
          && validOwnedImagePath(data.path, ownerId, prefix)
          && hasWriteTimestamps(data);
    }

    function publicRelationEndpointsExist(data) {
      let sourceRef = /databases/$(database)/documents/pnjs/$(data.source);
      let cibleRef = /databases/$(database)/documents/pnjs/$(data.cible);
      return relationEndpointsExist(data)
          && getAfter(sourceRef).data.visibleJoueurs == true
          && getAfter(cibleRef).data.visibleJoueurs == true;
    }

    // exists() avant get() : sur un document absent, get(...).data fait échouer
    // l'évaluation de la règle, ce qui refuse l'accès à TOUT LE MONDE, MJ compris.
    // En repli sur {}, les joueurs sont refusés mais la branche isGM() continue
    // de fonctionner — panne partielle plutôt que verrouillage total.
    function acces() {
      let ref = /databases/$(database)/documents/campagne/acces;
      return exists(ref) ? get(ref).data : {};
    }

    // ── Fiches : le MJ, ou une adresse listée dans campagne/acces ──
    match /fiches/{charId} {
      allow read, write: if isGM()
        || (request.auth != null
            // .lower() sur l'adresse entrante : Google la renvoie en minuscules,
            // mais rien ne le garantit. Les valeurs de campagne/acces doivent
            // donc être saisies en minuscules — le langage de règles ne sait pas
            // parcourir une liste pour les normaliser.
            && request.auth.token.email.lower() in acces().get(charId, []));
    }

    // ── Table d'accès : contient les adresses des joueurs, donc des données
    //    personnelles. Lecture réservée au MJ, jamais exposée au navigateur.
    //    La fonction acces() ci-dessus la consulte côté serveur, ce qui ne
    //    demande aucun droit de lecture au client. ──
    match /campagne/acces {
      allow read, write: if isGM();
    }

    // ── Pas de règle pour campagne/state : le document n'existe pas et le
    //    calendrier impérial ne lit plus Firestore depuis le brief L2-16,
    //    où il est devenu une fonction pure de la date du jour. ──

    // ── PNJs et relations : lecture publique explicitement filtrée, édition MJ ──
    match /pnjs/{id} {
      allow read: if isGM() || resource.data.visibleJoueurs == true;
      allow create: if isGM() && validPnj(request.resource.data)
          && validImagePath(request.resource.data, id, 'portraits')
          && !deletionLockActive()
          && !imageLockActive('pnjs', id)
          && validDeletionMarker(request.resource.data)
          && !request.resource.data.keys().hasAny(['suppressionEnCours'])
          && !request.resource.data.keys().hasAny(['imageUrl'])
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if isGM() && !resource.data.get('suppressionEnCours', false)
          && validPnj(request.resource.data)
          && validImagePath(request.resource.data, id, 'portraits')
          && validDeletionMarker(request.resource.data)
          && validUpdate(resource.data, request.resource.data,
              ['nom', 'statut', 'vivant', 'lieu', 'groupe', 'description', 'imageUrl',
               'imagePath', 'visibleJoueurs', 'createdAt', 'updatedAt', 'ordre', 'suppressionEnCours'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && legacyImageUrlUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && (!changesImage(resource.data, request.resource.data)
              || !imageLockActive('pnjs', id))
          && (
            (request.resource.data.get('suppressionEnCours', false) == true
              && !resource.data.get('suppressionEnCours', false)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['suppressionEnCours', 'updatedAt'])
              && lockAfterTargetsPnj(id))
            || (request.resource.data.get('suppressionEnCours', false) != true
              && !deletionLockActive())
          );
      allow delete: if isGM()
          && resource.data.get('suppressionEnCours', false) == true
          && deletionLockActive()
          && get(deletionLockRef()).data.get('pnjId', '') == id;
    }

    match /integrity_locks/{id} {
      allow read: if isGM();
      allow create: if isGM() && id == 'pnj-deletion'
          && validDeletionLock(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data)
          && existsAfter(/databases/$(database)/documents/pnjs/$(request.resource.data.pnjId))
          && getAfter(/databases/$(database)/documents/pnjs/$(request.resource.data.pnjId))
               .data.get('suppressionEnCours', false) == true;
      allow update: if false;
      allow delete: if isGM() && id == 'pnj-deletion'
          && resource.data.pnjId is string
          && !existsAfter(/databases/$(database)/documents/pnjs/$(resource.data.pnjId));
    }

    match /integrity_locks/images/{ownerCollection}/{ownerId} {
      allow read: if isGM();
      allow create: if isGM()
          && (ownerCollection == 'pnjs' || ownerCollection == 'indices')
          && validImageCleanupLock(request.resource.data, ownerCollection, ownerId)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if false;
      allow delete: if isGM();
    }
    match /relations/{id} {
      // Les règles ne peuvent pas prouver une jointure PNJ pour chaque document d'une liste.
      // L'invariant est donc imposé aux écritures et contrôlé par le préflight avant activation.
      allow read: if isGM() || resource.data.visibleJoueurs == true;
      allow create: if isGM() && validRelation(request.resource.data)
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data)
          && relationEndpointsExist(request.resource.data)
          && (request.resource.data.visibleJoueurs != true
              || publicRelationEndpointsExist(request.resource.data));
      allow update: if isGM() && validRelation(request.resource.data)
          && validUpdate(resource.data, request.resource.data,
              ['source', 'cible', 'type', 'label', 'color', 'style', 'visibleJoueurs',
               'createdAt', 'updatedAt'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && relationEndpointsExist(request.resource.data)
          && (request.resource.data.visibleJoueurs != true
              || publicRelationEndpointsExist(request.resource.data));
      allow delete: if isGM();
    }

    // ── Notes privées : aucune lecture ou écriture hors MJ vérifié ──
    match /pnjs_prives/{id} {
      allow read: if isGM();
      allow create: if isGM() && validPrivatePnj(request.resource.data)
          && activePnjAfter(id)
          && request.resource.data.keys().hasAny(['updatedAt'])
          && request.resource.data.updatedAt is timestamp
          && serverUpdated(request.resource.data);
      allow update: if isGM() && validPrivatePnj(request.resource.data)
          && activePnjAfter(id)
          && validUpdate(resource.data, request.resource.data, ['notes', 'updatedAt'])
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data);
      allow delete: if isGM();
    }

    // ── Indices : un secret non découvert n'est pas lisible ──
    // Note : cette règle impose que les requêtes en liste portent la contrainte
    // `where('decouvert', '==', true)` pour les utilisateurs non-MJ.
    match /indices/{id} {
      allow read:  if isGM() || resource.data.decouvert == true;
      allow create: if isGM() && validIndice(request.resource.data)
          && validImagePath(request.resource.data, id, 'indices')
          && !deletionLockActive()
          && !imageLockActive('indices', id)
          && !request.resource.data.keys().hasAny(['imageUrl'])
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if isGM() && validIndice(request.resource.data)
          && validImagePath(request.resource.data, id, 'indices')
          && (!deletionLockActive() || cascadeIndiceUpdate(resource.data, request.resource.data))
          && validUpdate(resource.data, request.resource.data,
              ['titre', 'description', 'decouvert', 'pnjsLies', 'imageUrl', 'imagePath',
               'dateDecouverte', 'source', 'type', 'createdAt', 'updatedAt', 'ordre'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && legacyImageUrlUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && (!changesImage(resource.data, request.resource.data)
              || !imageLockActive('indices', id));
      allow delete: if isGM();
    }

    // ── Sondage : le vote reste anonyme, par choix de conception.
    //    Un visiteur sans compte peut ajouter ou modifier SA réponse, une à
    //    la fois. Il ne peut ni supprimer une réponse existante, ni toucher
    //    aux dates, ni clôturer, ni supprimer le sondage.
    //    Limite : le pseudo étant une clé de la map responses, il ne peut pas
    //    être validé côté serveur ; sa protection repose sur l'échappement client. ──
    match /doodle/current {
      allow read: if true;
      allow create, delete: if isGM();
      allow update: if isGM() || (
           request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['responses'])
        && request.resource.data.responses.size() <= 30
        && request.resource.data.responses.diff(resource.data.responses)
                 .affectedKeys().size() == 1
        // Aucun votant existant ne disparaît : interdit la suppression
        // d'une réponse par un anonyme, que le MJ conserve via isGM().
        && request.resource.data.responses.keys()
                 .hasAll(resource.data.responses.keys())
      );
    }

    // ── Courriels : création seule, destinataire et forme imposés ──
    match /mail/{id} {
      allow read, update, delete: if false;
      allow create: if
           request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to == 'ethoril@gmail.com'
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html.size() <= 2000;
    }
  }
}
