rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGM() {
      return request.auth != null
          && request.auth.token.email == 'ethoril@gmail.com'
          && request.auth.token.email_verified == true;
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validText(data, field, maximum) {
      return !data.keys().hasAny([field])
          || (data[field] is string && data[field].size() <= maximum);
    }

    function validImagePath(data, ownerId, prefix) {
      return !data.keys().hasAny(['imagePath'])
          || (data.imagePath is string
              && data.imagePath.split('/').size() == 3
              && data.imagePath.split('/')[0] == prefix
              && data.imagePath.split('/')[1] == ownerId
              && data.imagePath.split('/')[2].size() > 0
              && data.imagePath.split('/')[2].size() <= 128);
    }

    function validOwnerId(ownerId) {
      return ownerId is string && ownerId.size() > 0 && ownerId.size() <= 100
          && ownerId.matches('^[A-Za-z0-9_-]+$');
    }

    function validGraphPosition(data) {
      return data.keys().hasAll(['x', 'y', 'updatedAt'])
          && data.keys().hasOnly(['x', 'y', 'updatedAt'])
          && (data.x is int || data.x is float)
          && (data.y is int || data.y is float)
          && data.x >= -1000000 && data.x <= 1000000
          && data.y >= -1000000 && data.y <= 1000000
          && data.updatedAt is timestamp
          && data.updatedAt == request.time;
    }

    function positionPnjVisible(id) {
      let ref = /databases/$(database)/documents/pnjs/$(id);
      return exists(ref)
          && get(ref).data.visibleJoueurs == true
          && get(ref).data.get('suppressionEnCours', false) != true;
    }

    function positionPnjExists(id) {
      return exists(/databases/$(database)/documents/pnjs/$(id));
    }

    function managedPnj(id) {
      let metadataId = 'pnj_' + id;
      return exists(/databases/$(database)/documents/content_metadata/$(metadataId));
    }

    function managedIndice(id) {
      let metadataId = 'indice_' + id;
      return exists(/databases/$(database)/documents/content_metadata/$(metadataId));
    }

    function managedRelation(id) {
      let metadataId = 'relation_' + id;
      return exists(/databases/$(database)/documents/content_metadata/$(metadataId));
    }

    function validOwnedImagePath(path, ownerId, prefix) {
      return validOwnerId(ownerId) && path is string
          && path.split('/').size() == 3
          && path.split('/')[0] == prefix
          && path.split('/')[1] == ownerId
          && path.split('/')[2].size() > 0
          && path.split('/')[2].size() <= 128
          && path.split('/')[2] != '.' && path.split('/')[2] != '..';
    }

    function validTimestamp(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp;
    }

    function hasWriteTimestamps(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt'])
          && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function hasUpdatedTimestamp(data) {
      return data.keys().hasAny(['updatedAt']) && data.updatedAt is timestamp;
    }

    function validPnj(data) {
      return hasOnly(data, ['nom', 'statut', 'vivant', 'lieu', 'groupe', 'description',
          'imageUrl', 'imagePath', 'visibleJoueurs', 'createdAt', 'updatedAt', 'ordre',
          'suppressionEnCours', 'groupes'])
        && data.visibleJoueurs is bool
        && data.nom is string && data.nom.size() > 0 && data.nom.size() <= 200
        && validText(data, 'statut', 64)
        && validText(data, 'vivant', 32)
        && validText(data, 'lieu', 200)
        && validText(data, 'groupe', 200)
        && validGroups(data)
        && validText(data, 'description', 20000)
        && validText(data, 'imageUrl', 2048)
        && validText(data, 'imagePath', 512)
        && (!data.keys().hasAny(['ordre']) || data.ordre == null
            || data.ordre is int || data.ordre is float)
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validGroups(data) {
      return !data.keys().hasAny(['groupes'])
          || (data.groupes is list && data.groupes.size() <= 20
              && data.keys().hasAny(['groupe'])
              && (data.groupes.size() == 0 || (data.groupes[0] is string
                  && data.groupes[0] != '' && data.groupes[0].size() <= 200))
              && data.groupe == (data.groupes.size() == 0 ? '' : data.groupes[0]));
    }

    function validDeletionMarker(data) {
      return !data.keys().hasAny(['suppressionEnCours'])
          || data.suppressionEnCours is bool;
    }

    function validRelation(data) {
      return hasOnly(data, ['source', 'cible', 'type', 'label', 'color', 'style',
          'visibleJoueurs', 'curvature', 'createdAt', 'updatedAt'])
        && data.visibleJoueurs is bool
        && data.source is string && data.source.size() > 0 && data.source.size() <= 150
        && data.cible is string && data.cible.size() > 0 && data.cible.size() <= 150
        && data.source != data.cible
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && validText(data, 'label', 300)
        && (!data.keys().hasAny(['color']) || data.color == null || validText(data, 'color', 32))
        && (!data.keys().hasAny(['style']) || data.style == 'solid' || data.style == 'dashed')
        && (!data.keys().hasAny(['curvature']) || data.curvature == null
            || ((data.curvature is int || data.curvature is float)
                && data.curvature >= -6 && data.curvature <= 6))
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validPrivatePnj(data) {
      return hasOnly(data, ['notes', 'updatedAt'])
        && data.notes is string && data.notes.size() <= 30000
        && validTimestamp(data, 'updatedAt');
    }

    function validIndice(data) {
      return hasOnly(data, ['titre', 'description', 'decouvert', 'pnjsLies', 'imageUrl',
          'imagePath', 'dateDecouverte', 'source', 'type', 'createdAt', 'updatedAt', 'ordre'])
        && data.titre is string && data.titre.size() > 0 && data.titre.size() <= 200
        && data.decouvert is bool
        && data.pnjsLies is list
        && data.pnjsLies.size() <= 100
        && validText(data, 'description', 30000)
        && validText(data, 'imageUrl', 2048)
        && validText(data, 'imagePath', 512)
        && (!data.keys().hasAny(['dateDecouverte']) || data.dateDecouverte == null
            || data.dateDecouverte is timestamp)
        && validText(data, 'source', 150)
        && validText(data, 'type', 100)
        && (!data.keys().hasAny(['ordre']) || data.ordre == null
            || data.ordre is int || data.ordre is float)
        && validTimestamp(data, 'createdAt')
        && validTimestamp(data, 'updatedAt');
    }

    function validUpdate(oldData, newData, validator) {
      return newData.diff(oldData).affectedKeys().hasOnly(validator);
    }

    function createdAtUnchanged(oldData, newData) {
      return !oldData.keys().hasAny(['createdAt'])
          || newData.createdAt == oldData.createdAt;
    }

    function legacyImageUrlUnchanged(oldData, newData) {
      return !newData.keys().hasAny(['imageUrl'])
          || (oldData.keys().hasAny(['imageUrl']) && newData.imageUrl == oldData.imageUrl);
    }

    function serverCreatedAndUpdated(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function serverUpdated(data) {
      return data.updatedAt == request.time;
    }

    // Carnaval est exclusivement MJ. Le calendrier du livre et ses présences
    // restent dans ce document privé et ne sont créés qu'une fois.
    function validCarnavalSource(data) {
      return data.keys().hasOnly(['version', 'days', 'places', 'characters', 'events', 'updatedAt'])
        && data.version == 1
        && data.days is list && data.days.size() == 8
        && data.places is list && data.places.size() <= 50
        && data.characters is list && data.characters.size() <= 500
        && data.events is list && data.events.size() <= 250
        && data.updatedAt is timestamp && serverUpdated(data);
    }

    function validCarnavalCampaign(data) {
      return data.keys().hasOnly(['version', 'revision', 'clock', 'links', 'overrides', 'customEvents', 'notes', 'updatedAt'])
        && data.version == 1
        && data.revision is int && data.revision >= 0
        && data.clock is map
        && data.clock.keys().hasOnly(['day', 'minute'])
        && data.clock.day is int && data.clock.day >= 1 && data.clock.day <= 8
        && data.clock.minute is int && data.clock.minute >= 0 && data.clock.minute <= 1800
        && data.links is map && data.links.size() <= 500
        && data.overrides is map && data.overrides.size() <= 250
        && data.customEvents is list && data.customEvents.size() <= 100
        && data.notes is map && data.notes.size() <= 350
        && data.updatedAt is timestamp && serverUpdated(data);
    }

    function relationEndpointsExist(data) {
      let sourceRef = /databases/$(database)/documents/pnjs/$(data.source);
      let cibleRef = /databases/$(database)/documents/pnjs/$(data.cible);
      return existsAfter(sourceRef) && existsAfter(cibleRef)
          && getAfter(sourceRef).data.get('suppressionEnCours', false) != true
          && getAfter(cibleRef).data.get('suppressionEnCours', false) != true;
    }

    function activePnjAfter(id) {
      let pnjRef = /databases/$(database)/documents/pnjs/$(id);
      return existsAfter(pnjRef)
          && getAfter(pnjRef).data.get('suppressionEnCours', false) != true;
    }

    function deletionLockRef() {
      return /databases/$(database)/documents/integrity_locks/pnj-deletion;
    }

    function deletionLockActive() {
      return exists(deletionLockRef());
    }

    function validDeletionLock(data) {
      return hasOnly(data, ['pnjId', 'imagePaths', 'legacyImageSkipped', 'createdAt', 'updatedAt'])
          && data.pnjId is string && data.pnjId.size() > 0 && data.pnjId.size() <= 150
          && data.imagePaths is list && data.imagePaths.size() <= 2
          && data.legacyImageSkipped is bool
          && (data.imagePaths.size() == 0
              || validOwnedImagePath(data.imagePaths[0], data.pnjId, 'portraits'))
          && (data.imagePaths.size() < 2
              || validOwnedImagePath(data.imagePaths[1], data.pnjId, 'portraits'))
          && hasWriteTimestamps(data);
    }

    function lockAfterTargetsPnj(id) {
      return existsAfter(deletionLockRef())
          && getAfter(deletionLockRef()).data.get('pnjId', '') == id;
    }

    function cascadeIndiceUpdate(oldData, newData) {
      return deletionLockActive()
          && newData.diff(oldData).affectedKeys().hasOnly(['pnjsLies', 'updatedAt'])
          && oldData.pnjsLies is list && newData.pnjsLies is list
          && oldData.pnjsLies.hasAny([get(deletionLockRef()).data.pnjId])
          && !newData.pnjsLies.hasAny([get(deletionLockRef()).data.pnjId])
          && oldData.pnjsLies.hasAll(newData.pnjsLies)
          && newData.pnjsLies.size() == oldData.pnjsLies.size() - 1;
    }

    function imageLockRef(ownerCollection, ownerId) {
      return /databases/$(database)/documents/integrity_locks/images/$(ownerCollection)/$(ownerId);
    }

    function imageLockActive(ownerCollection, ownerId) {
      return exists(imageLockRef(ownerCollection, ownerId));
    }

    function changesImage(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasAny(['imagePath', 'imageUrl']);
    }

    function validImageCleanupLock(data, ownerCollection, ownerId) {
      let prefix = ownerCollection == 'pnjs' ? 'portraits' : 'indices';
      return hasOnly(data, ['ownerCollection', 'ownerId', 'path', 'createdAt', 'updatedAt'])
          && data.ownerCollection == ownerCollection
          && data.ownerId == ownerId
          && validOwnedImagePath(data.path, ownerId, prefix)
          && hasWriteTimestamps(data);
    }

    function publicRelationEndpointsExist(data) {
      let sourceRef = /databases/$(database)/documents/pnjs/$(data.source);
      let cibleRef = /databases/$(database)/documents/pnjs/$(data.cible);
      return relationEndpointsExist(data)
          && getAfter(sourceRef).data.visibleJoueurs == true
          && getAfter(cibleRef).data.visibleJoueurs == true;
    }

    function publicRelationEndpointsNow(data) {
      let sourceRef = /databases/$(database)/documents/pnjs/$(data.source);
      let cibleRef = /databases/$(database)/documents/pnjs/$(data.cible);
      return exists(sourceRef) && exists(cibleRef)
          && get(sourceRef).data.visibleJoueurs == true
          && get(cibleRef).data.visibleJoueurs == true
          && get(sourceRef).data.get('suppressionEnCours', false) != true
          && get(cibleRef).data.get('suppressionEnCours', false) != true;
    }

    // exists() avant get() : sur un document absent, get(...).data fait échouer
    // l'évaluation de la règle, ce qui refuse l'accès à TOUT LE MONDE, MJ compris.
    // En repli sur {}, les joueurs sont refusés mais la branche isGM() continue
    // de fonctionner — panne partielle plutôt que verrouillage total.
    function acces() {
      let ref = /databases/$(database)/documents/campagne/acces;
      return exists(ref) ? get(ref).data : {};
    }

    function canReadFiche(charId) {
      return isGM() || (charId in ['bhelgi', 'caelel', 'elysia', 'hellaya', 'wren']
          && request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && request.auth.token.email.lower() in acces().get(charId, []));
    }

    function validPresence(charId, sessionId, data) {
      return request.auth != null
          && data.keys().hasOnly(['uid', 'displayName', 'role', 'lastSeenAt'])
          && data.uid == request.auth.uid
          && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
          && data.displayName is string && data.displayName.size() <= 100
          && data.lastSeenAt is timestamp && data.lastSeenAt == request.time
          && ((isGM() && data.role == 'mj')
              || (charId in ['bhelgi', 'caelel', 'elysia', 'hellaya', 'wren']
                  && request.auth.token.email_verified == true
                  && request.auth.token.email is string
                  && request.auth.token.email.lower() in acces().get(charId, [])
                  && data.role == 'joueur'))
          && sessionId.matches('^[A-Za-z0-9_-]{16,128}$');
    }

    // ── Fiches V2 : lecture vérifiée, écriture uniquement par callable Admin SDK ──
    match /fiches/{charId} {
      allow read: if canReadFiche(charId);
      allow write: if false;
      match /history/{operationId} {
        allow read: if canReadFiche(charId);
        allow write: if false;
      }
      match /operations/{operationId} {
        allow read: if canReadFiche(charId);
        allow write: if false;
      }
      match /migration_backups/{backupId} {
        allow read: if isGM();
        allow write: if false;
      }
      match /catalogue_backups/{backupId} {
        allow read: if isGM();
        allow write: if false;
      }
      match /command_backups/{operationId} {
        allow read: if isGM();
        allow write: if false;
      }
      match /presence/{sessionId} {
        allow read: if canReadFiche(charId);
        allow create: if validPresence(charId, sessionId, request.resource.data);
        allow update: if resource.data.uid == request.auth.uid
            && validPresence(charId, sessionId, request.resource.data);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }

    // Métadonnées et reçus ne sont accessibles que par les callables/Admin SDK.
    match /content_metadata/{id} { allow read, write: if false; }
    match /content_history/{contentKey}/events/{eventId} { allow read, write: if false; }
    match /content_operations/{operationId} { allow read, write: if false; }
    match /content_trash/{trashId} { allow read, write: if false; }
    match /content_trash_archive/{archiveId} { allow read, write: if false; }
    match /content_image_reservations/{reservationId} { allow read, write: if false; }

    // Seul le snapshot filtré publié par le service catalogue est lisible côté client.
    // Brouillons, prévisualisations persistées, opérations et décisions restent privés MJ/serveur.
    match /referentiels/public {
      allow get: if true;
      allow list, write: if false;
    }
    match /referentiels/{document=**} { allow read, write: if false; }
    match /referentiel_drafts/{document} { allow read, write: if false; }
    match /referentiel_history/{operationId} { allow read, write: if false; }
    match /referentiel_operations/{operationId} { allow read, write: if false; }

    // ── Table d'accès : contient les adresses des joueurs, donc des données
    //    personnelles. Lecture réservée au MJ, jamais exposée au navigateur.
    //    La fonction acces() ci-dessus la consulte côté serveur, ce qui ne
    //    demande aucun droit de lecture au client. ──
    match /campagne/acces {
      allow read, write: if isGM();
    }

    // ── Pas de règle pour campagne/state : le document n'existe pas et le
    //    calendrier impérial ne lit plus Firestore depuis le brief L2-16,
    //    où il est devenu une fonction pure de la date du jour. ──

    // ── PNJs et relations : lecture publique explicitement filtrée, édition MJ ──
    match /pnjs/{id} {
      allow read: if isGM() || resource.data.visibleJoueurs == true;
      allow create: if !managedPnj(id) && isGM() && validPnj(request.resource.data)
          && validImagePath(request.resource.data, id, 'portraits')
          && !deletionLockActive()
          && !imageLockActive('pnjs', id)
          && validDeletionMarker(request.resource.data)
          && !request.resource.data.keys().hasAny(['suppressionEnCours'])
          && !request.resource.data.keys().hasAny(['imageUrl'])
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if !managedPnj(id) && (!acces().get('enqEnabled', false) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibleJoueurs', 'suppressionEnCours'])) && isGM() && !resource.data.get('suppressionEnCours', false)
          && validPnj(request.resource.data)
          && validImagePath(request.resource.data, id, 'portraits')
          && validDeletionMarker(request.resource.data)
          && validUpdate(resource.data, request.resource.data,
              ['nom', 'statut', 'vivant', 'lieu', 'groupe', 'groupes', 'description', 'imageUrl',
               'imagePath', 'visibleJoueurs', 'createdAt', 'updatedAt', 'ordre', 'suppressionEnCours'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && legacyImageUrlUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && (!changesImage(resource.data, request.resource.data)
              || !imageLockActive('pnjs', id))
          && (
            (request.resource.data.get('suppressionEnCours', false) == true
              && !resource.data.get('suppressionEnCours', false)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['suppressionEnCours', 'updatedAt'])
              && lockAfterTargetsPnj(id))
            || (request.resource.data.get('suppressionEnCours', false) != true
              && !deletionLockActive())
          );
      allow delete: if !acces().get('enqEnabled', false) && !managedPnj(id) && isGM()
          && resource.data.get('suppressionEnCours', false) == true
          && deletionLockActive()
          && get(deletionLockRef()).data.get('pnjId', '') == id;
    }

    // ── Coordonnées de graphe : séparées des fiches PNJ et sans autre donnée. ──
    // Les joueurs ne peuvent cibler que des IDs précis avec documentId() in;
    // chaque document vérifie lui-même la visibilité de son PNJ lié.
    match /pnj_positions/{id} {
      allow read: if isGM() || positionPnjVisible(id);
      allow create, update: if validGraphPosition(request.resource.data)
          && ((isGM() && positionPnjExists(id)) || positionPnjVisible(id));
      allow delete: if isGM();
    }

    match /integrity_locks/{id} {
      allow read: if isGM();
      allow create: if isGM() && id == 'pnj-deletion'
          && validDeletionLock(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data)
          && existsAfter(/databases/$(database)/documents/pnjs/$(request.resource.data.pnjId))
          && getAfter(/databases/$(database)/documents/pnjs/$(request.resource.data.pnjId))
               .data.get('suppressionEnCours', false) == true;
      allow update: if false;
      allow delete: if isGM() && id == 'pnj-deletion'
          && resource.data.pnjId is string
          && !existsAfter(/databases/$(database)/documents/pnjs/$(resource.data.pnjId));
    }

    match /integrity_locks/images/{ownerCollection}/{ownerId} {
      allow read: if isGM();
      allow create: if isGM()
          && (ownerCollection == 'pnjs' || ownerCollection == 'indices')
          && validImageCleanupLock(request.resource.data, ownerCollection, ownerId)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if false;
      allow delete: if isGM();
    }
    match /relations/{id} {
      // Les règles ne peuvent pas prouver une jointure PNJ pour chaque document d'une liste.
      // L'invariant est donc imposé aux écritures et contrôlé par le préflight avant activation.
      allow read: if isGM() || (resource.data.visibleJoueurs == true && publicRelationEndpointsNow(resource.data));
      allow create: if !managedRelation(id) && isGM() && validRelation(request.resource.data)
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data)
          && relationEndpointsExist(request.resource.data)
          && (request.resource.data.visibleJoueurs != true
              || publicRelationEndpointsExist(request.resource.data));
      allow update: if (
          !managedRelation(id) && isGM() && validRelation(request.resource.data)
          && validUpdate(resource.data, request.resource.data,
              ['source', 'cible', 'type', 'label', 'color', 'style', 'visibleJoueurs',
               'curvature', 'createdAt', 'updatedAt'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && relationEndpointsExist(request.resource.data)
          && (request.resource.data.visibleJoueurs != true
              || publicRelationEndpointsExist(request.resource.data)))
        || (!isGM() && validRelation(request.resource.data)
          && resource.data.visibleJoueurs == true
          && request.resource.data.visibleJoueurs == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['curvature', 'updatedAt'])
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && publicRelationEndpointsExist(request.resource.data));
      allow delete: if isGM() && !managedRelation(id);
    }

    // ── Notes privées : aucune lecture ou écriture hors MJ vérifié ──
    match /pnjs_prives/{id} {
      allow read: if isGM();
      allow create: if isGM() && validPrivatePnj(request.resource.data)
          && activePnjAfter(id)
          && request.resource.data.keys().hasAny(['updatedAt'])
          && request.resource.data.updatedAt is timestamp
          && serverUpdated(request.resource.data);
      allow update: if isGM() && validPrivatePnj(request.resource.data)
          && activePnjAfter(id)
          && validUpdate(resource.data, request.resource.data, ['notes', 'updatedAt'])
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data);
      allow delete: if isGM();
    }

    // ── Indices : un secret non découvert n'est pas lisible ──
    // Note : cette règle impose que les requêtes en liste portent la contrainte
    // `where('decouvert', '==', true)` pour les utilisateurs non-MJ.
    match /indices/{id} {
      allow read:  if isGM() || (!acces().get('enqEnabled', false) && resource.data.decouvert == true);
      allow create: if !acces().get('enqEnabled', false) && !managedIndice(id) && isGM() && validIndice(request.resource.data)
          && validImagePath(request.resource.data, id, 'indices')
          && !deletionLockActive()
          && !imageLockActive('indices', id)
          && !request.resource.data.keys().hasAny(['imageUrl'])
          && hasWriteTimestamps(request.resource.data)
          && serverCreatedAndUpdated(request.resource.data);
      allow update: if !acces().get('enqEnabled', false) && !managedIndice(id) && isGM() && validIndice(request.resource.data)
          && validImagePath(request.resource.data, id, 'indices')
          && (!deletionLockActive() || cascadeIndiceUpdate(resource.data, request.resource.data))
          && validUpdate(resource.data, request.resource.data,
              ['titre', 'description', 'decouvert', 'pnjsLies', 'imageUrl', 'imagePath',
               'dateDecouverte', 'source', 'type', 'createdAt', 'updatedAt', 'ordre'])
          && createdAtUnchanged(resource.data, request.resource.data)
          && legacyImageUrlUnchanged(resource.data, request.resource.data)
          && hasUpdatedTimestamp(request.resource.data)
          && serverUpdated(request.resource.data)
          && (!changesImage(resource.data, request.resource.data)
              || !imageLockActive('indices', id));
      allow delete: if !acces().get('enqEnabled', false) && !managedIndice(id) && isGM();
    }

    // ── Sondage : le vote reste anonyme, par choix de conception.
    //    Un visiteur sans compte peut ajouter ou modifier SA réponse, une à
    //    la fois. Il ne peut ni supprimer une réponse existante, ni toucher
    //    aux dates, ni clôturer, ni supprimer le sondage.
    //    Limite : le pseudo étant une clé de la map responses, il ne peut pas
    //    être validé côté serveur ; sa protection repose sur l'échappement client. ──
    match /doodle/current {
      allow read: if true;
      allow create, delete: if isGM();
      allow update: if isGM() || (
           request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['responses'])
        && request.resource.data.responses.size() <= 30
        && request.resource.data.responses.diff(resource.data.responses)
                 .affectedKeys().size() == 1
        // Aucun votant existant ne disparaît : interdit la suppression
        // d'une réponse par un anonyme, que le MJ conserve via isGM().
        && request.resource.data.responses.keys()
                 .hasAll(resource.data.responses.keys())
      );
    }

    // ── Carnaval : contenu et suivi exclusivement MJ ──
    match /carnaval_sources/current {
      allow read: if isGM();
      allow create: if isGM() && validCarnavalSource(request.resource.data);
      allow update, delete: if false;
    }

    match /carnaval_campaigns/current {
      allow read: if isGM();
      allow create: if isGM() && validCarnavalCampaign(request.resource.data)
          && request.resource.data.revision == 0;
      allow update: if isGM() && validCarnavalCampaign(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // Les modèles d'équipement sont des copies privées, créées exclusivement par le MJ.
    match /equipment_models/{id} {
      allow read, delete: if isGM();
      allow create: if isGM() && id.matches('^[A-Za-z0-9_-]{1,100}$')
        && request.resource.data.keys().hasOnly(['item', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.item is map
        && request.resource.data.item.keys().hasOnly(['id', 'baseId', 'catalogVersion', 'kind', 'name', 'category', 'damage', 'reach', 'range', 'ap', 'locations', 'layer', 'keywords', 'notes', 'source', 'custom'])
        && request.resource.data.item.name is string && request.resource.data.item.name.size() > 0
        && request.resource.data.item.name.size() <= 300
        && request.resource.data.item.keys().hasAll(['id', 'baseId', 'catalogVersion', 'kind', 'name', 'category', 'damage', 'reach', 'range', 'ap', 'locations', 'layer', 'keywords', 'notes', 'source', 'custom'])
        && request.resource.data.item.kind in ['weapon', 'armour', 'shield', 'ammunition']
        && request.resource.data.item.layer in ['leather', 'flexible', 'rigid', 'bonus', 'none']
        && request.resource.data.item.custom is bool
        && (request.resource.data.item.ap == null || (request.resource.data.item.ap is int && request.resource.data.item.ap >= 0 && request.resource.data.item.ap <= 100))
        && request.resource.data.item.locations is list && request.resource.data.item.locations.size() <= 6
        && request.resource.data.item.locations.hasOnly(['head', 'body', 'rightArm', 'leftArm', 'rightLeg', 'leftLeg'])
        && validText(request.resource.data.item, 'id', 300)
        && validText(request.resource.data.item, 'baseId', 300)
        && validText(request.resource.data.item, 'catalogVersion', 300)
        && validText(request.resource.data.item, 'category', 300)
        && validText(request.resource.data.item, 'damage', 300)
        && validText(request.resource.data.item, 'reach', 300)
        && validText(request.resource.data.item, 'range', 300)
        && validText(request.resource.data.item, 'notes', 5000)
        && validText(request.resource.data.item, 'source', 5000)
        && request.resource.data.item.keywords is list && request.resource.data.item.keywords.size() <= 60;
      allow update: if false;
    }

    // ── Courriels : création seule, destinataire et forme imposés ──
    match /mail/{id} {
      allow read, update, delete: if false;
      allow create: if
           request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to == 'ethoril@gmail.com'
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html.size() <= 2000;
    }

    // Documents and investigations V2. Shared mutations are server-only.
    function enqMember() {
      return isGM() || (request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && (request.auth.token.email.lower() in acces().get('bhelgi', [])
        || request.auth.token.email.lower() in acces().get('caelel', [])
        || request.auth.token.email.lower() in acces().get('elysia', [])
        || request.auth.token.email.lower() in acces().get('hellaya', [])
        || request.auth.token.email.lower() in acces().get('wren', [])));
    }
    function enqOpen() { return acces().get('enqEnabled', false) == true && acces().get('enqMaintenance', null) == null; }
    function ownEnq(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/enq_accounts/$(uid)); }
    function validEnqNote(uid, id, data) {
      return ownEnq(uid) && data.keys().hasOnly(['id','type','authorUid','titre','texte','etiquettes','revision','operationId','createdAt','updatedAt'])
        && data.id == id && data.type == 'notes' && data.authorUid == uid
        && data.texte is string && data.texte.size() > 0 && data.texte.size() <= 100000
        && validText(data,'titre',200) && data.etiquettes is list && data.etiquettes.size() <= 30
        && data.revision is int && data.revision >= 1
        && data.operationId is string && validOwnerId(data.operationId)
        && getAfter(/databases/$(database)/documents/enq_users/$(uid)/receipts/$(data.operationId)).data.id == id
        && getAfter(/databases/$(database)/documents/enq_users/$(uid)/receipts/$(data.operationId)).data.revision == data.revision
        && getAfter(/databases/$(database)/documents/enq_registry/$(id)).data.zone == 'user:' + uid
        && getAfter(/databases/$(database)/documents/enq_registry/$(id)).data.revision == data.revision
        && !exists(/databases/$(database)/documents/pnjs/$(id))
        && data.updatedAt == request.time && data.createdAt is timestamp;
    }
    match /enq_control/public { allow read: if request.auth != null; allow write: if false; }
    match /enq_commun/data/{kind}/{id} { allow read: if enqMember() && enqOpen(); allow write: if false; }
    match /enq_mj/data/{kind}/{id} { allow read: if isGM() && enqOpen(); allow write: if false; }
    match /enq_users/{uid}/{kind}/{id} {
      allow read: if ownEnq(uid);
      allow create: if kind == 'notes' && validEnqNote(uid,id,request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if kind == 'notes' && validEnqNote(uid,id,request.resource.data)
        && resource.data.authorUid == uid && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && get(/databases/$(database)/documents/enq_registry/$(id)).data.state == 'active';
      allow delete: if false;
    }
    match /enq_users/{uid}/receipts/{operationId} {
      allow read: if ownEnq(uid);
      allow create: if ownEnq(uid) && request.resource.data.keys().hasOnly(['id','revision','hash','createdAt'])
        && request.resource.data.id is string && request.resource.data.hash is string
        && request.resource.data.revision == getAfter(/databases/$(database)/documents/enq_users/$(uid)/notes/$(request.resource.data.id)).data.revision
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/enq_users/$(uid)/notes/$(request.resource.data.id)).data.operationId == operationId;
      allow update, delete: if false;
    }
    match /enq_registry/{id} {
      allow read: if request.auth != null && ownEnq(request.auth.uid) && resource.data.zone == 'user:' + request.auth.uid && resource.data.type == 'notes';
      allow create, update: if request.auth != null && ownEnq(request.auth.uid)
        && request.resource.data.keys().hasOnly(['id','type','zone','authorUid','state','revision','refs','createdAt'])
        && (!exists(/databases/$(database)/documents/enq_registry/$(id)) || (resource.data.type == 'notes' && resource.data.zone == 'user:' + request.auth.uid && resource.data.state == 'active'))
        && request.resource.data.id == id && request.resource.data.type == 'notes'
        && request.resource.data.zone == 'user:' + request.auth.uid
        && request.resource.data.authorUid == request.auth.uid && request.resource.data.state == 'active'
        && request.resource.data.refs == []
        && request.resource.data.revision == getAfter(/databases/$(database)/documents/enq_users/$(request.auth.uid)/notes/$(id)).data.revision
        && request.resource.data.createdAt == getAfter(/databases/$(database)/documents/enq_users/$(request.auth.uid)/notes/$(id)).data.createdAt;
      allow delete: if false;
    }
  }
}







