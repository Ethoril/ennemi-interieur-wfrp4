rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isGM() {
      return request.auth != null
          && request.auth.token.email == 'ethoril@gmail.com'
          && request.auth.token.email_verified == true;
    }

    function publicPnj(pnjId) {
      return firestore.exists(/databases/(default)/documents/pnjs/$(pnjId))
          && firestore.get(/databases/(default)/documents/pnjs/$(pnjId)).data.visibleJoueurs == true;
    }

    function publicIndice(indiceId) {
      return firestore.exists(/databases/(default)/documents/indices/$(indiceId))
          && firestore.get(/databases/(default)/documents/indices/$(indiceId)).data.decouvert == true;
    }

    // La callable Admin est la seule à créer les nouveaux objets. Les clients,
    // y compris le MJ, peuvent supprimer pour compenser un échec Firestore mais
    // ne peuvent pas réintroduire un token par un upload Web direct.
    match /portraits/{pnjId}/{fileName} {
      allow read: if isGM() || publicPnj(pnjId);
      allow create, update: if false;
      allow delete: if isGM();
    }

    match /indices/{indiceId}/{fileName} {
      allow read: if isGM() || publicIndice(indiceId);
      allow create, update: if false;
      allow delete: if isGM();
    }

    // Les objets plats legacy peuvent encore être lus/supprimés par le MJ vérifié,
    // mais aucune nouvelle écriture ne doit prolonger la fuite.
    match /portraits/{legacyFile} {
      allow read, delete: if isGM();
    }
    match /indices/{legacyFile} {
      allow read, delete: if isGM();
    }

    function enqAccess() { return firestore.get(/databases/(default)/documents/campagne/acces).data; }
    function enqMember(access) {
      return isGM() || (request.auth != null && request.auth.token.email_verified == true
        && (request.auth.token.email.lower() in access.get('bhelgi', [])
        || request.auth.token.email.lower() in access.get('caelel', [])
        || request.auth.token.email.lower() in access.get('elysia', [])
        || request.auth.token.email.lower() in access.get('hellaya', [])
        || request.auth.token.email.lower() in access.get('wren', [])));
    }
    function enqFileReadable(docId,fileId,version) {
      let descriptor = firestore.get(/databases/(default)/documents/enq_file_access/$(fileId)).data;
      let access = enqAccess();
      return request.auth != null && descriptor.docId == docId && descriptor.active == true
        && access.get('enqMaintenance', null) == null
        && ((descriptor.zone == 'user:' + request.auth.uid && descriptor.ownerUid == request.auth.uid)
          || (enqMember(access) && access.get('enqEnabled', false) == true
            && (descriptor.zone == 'commun' || (descriptor.zone == 'mj' && isGM()))))
        && (descriptor.get('current', false) == true || descriptor.get('sharedAnnotation', false) == true
          || descriptor.ownerUid == request.auth.uid || isGM() && descriptor.zone != 'user:' + descriptor.ownerUid
          || request.auth.uid in descriptor.get('annotationReaders', []))
        && (version == 'thumb' || version == string(descriptor.version));
    }
    match /staging/{uid}/{uploadId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/enq_accounts/$(uid))
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf','text/plain','text/markdown']
        && !request.resource.metadata.keys().hasAny(['firebaseStorageDownloadTokens']);
    }
    match /documents/{docId}/{fileId}/{version} {
      allow read: if enqFileReadable(docId,fileId,version);
      allow write: if false;
    }
  }
}


