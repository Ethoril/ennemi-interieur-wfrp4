# Décrit l'existant, ne le réforme pas : l'indentation est volontairement
# hétérogène (4 espaces dans js/, 2 dans sw.js, js/main.js, HTML, CSS et MD).
# Voir docs/briefs/00-CONVENTIONS.md §4.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,json}]
indent_style = space
indent_size = 4

[{*.html,*.css,*.md,sw.js,js/main.js}]
indent_style = space
indent_size = 2
